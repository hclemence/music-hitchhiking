{
  "name": "music-hitchhiking",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run supabase/functions/_shared scripts",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "test:db": "supabase test db",
    "functions:serve": "supabase functions serve",
    "db:start:sandbox": "SUPABASE_INTERNAL_IMAGE_REGISTRY=docker.io supabase start -x studio,imgproxy,storage-api,logflare,vector,supavisor,mailpit,postgres-meta",
    "db:reset:sandbox": "SUPABASE_INTERNAL_IMAGE_REGISTRY=docker.io supabase db reset",
    "test:db:sandbox": "SUPABASE_INTERNAL_IMAGE_REGISTRY=docker.io supabase test db",
    "functions:serve:sandbox": "SUPABASE_INTERNAL_IMAGE_REGISTRY=docker.io supabase functions serve",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "packageManager": "pnpm@10.28.0",
  "devDependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@types/node": "^22.20.5",
    "supabase": "^3.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
