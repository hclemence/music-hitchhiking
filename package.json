{
  "name": "music-hitchhiking",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run supabase/functions/_shared",
    "db:start": "SUPABASE_INTERNAL_IMAGE_REGISTRY=docker.io supabase start -x studio,imgproxy,storage-api,logflare,vector,supavisor,mailpit,realtime,postgres-meta",
    "db:reset": "SUPABASE_INTERNAL_IMAGE_REGISTRY=docker.io supabase db reset",
    "test:db": "SUPABASE_INTERNAL_IMAGE_REGISTRY=docker.io supabase test db",
    "test:integration": "vitest run tests/integration"
  },
  "packageManager": "pnpm@10.28.0",
  "devDependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "supabase": "^3.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
