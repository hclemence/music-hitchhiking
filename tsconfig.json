{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "moduleResolution": "bundler",
    "module": "ESNext",
    "allowImportingTsExtensions": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "paths": { "@core/*": ["./supabase/functions/_shared/core/*"] }
  },
  "include": ["supabase/functions/_shared", "tests", "scripts", "vitest.config.ts", "vitest.integration.config.ts"]
}
